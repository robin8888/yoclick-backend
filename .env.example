# Copia este fichero a .env y rellénalo. .env está en .gitignore: nunca se sube.
# Todas las variables se validan al arrancar (src/shared/config/environment.schema.ts);
# si falta o es inválida alguna, el proceso no arranca y dice cuál.

NODE_ENV=development
# En contenedor hay que poner 0.0.0.0 de forma explícita.
HOST=127.0.0.1
PORT=3000
# En producción: info, warn o error (trace y debug se rechazan: pueden filtrar datos).
LOG_LEVEL=info

# --- Base de datos (PostgreSQL local, ver docs/local-setup.md) ---
# Sustituye CHANGE_ME_APP y CHANGE_ME_MIGRATOR por las contraseñas que pusiste al crear
# los roles yoclick_app y yoclick_migrator en DBeaver. Usa solo letras y números en ellas:
# un carácter como @ : / # ? rompería la URL.

# Rol de la API en ejecución (sin BYPASSRLS ni DDL). La usa la aplicación.
DATABASE_URL=postgresql://yoclick_app:CHANGE_ME_APP@localhost:5432/yoclick

# Rol dueño de las tablas. Solo para migraciones (prisma migrate). Nunca en producción en runtime.
MIGRATION_DATABASE_URL=postgresql://yoclick_migrator:CHANGE_ME_MIGRATOR@localhost:5432/yoclick

# Base de tests e2e: misma pareja de roles, otra base. Se vacía y se recrea; nunca datos reales.
TEST_DATABASE_URL=postgresql://yoclick_app:CHANGE_ME_APP@localhost:5432/yoclick_test
TEST_MIGRATION_DATABASE_URL=postgresql://yoclick_migrator:CHANGE_ME_MIGRATOR@localhost:5432/yoclick_test

# --- Claves de los tokens de acceso (Ed25519, PEM en base64) ---
# En desarrollo: `npm run keys:generate` las crea y las añade a tu .env.
# En producción: claves DISTINTAS, guardadas en el gestor de secretos del proveedor.
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
# Identifica la clave en cada token para poder rotarla. En producción no puede ser dev-1.
JWT_KEY_ID=dev-1

# --- Autenticación ---
# Pepper (>= 32 bytes, en base64) con el que se firman los códigos de 6 dígitos antes de guardarlos.
# En desarrollo lo crea `npm run keys:generate`. En producción: valor distinto en el gestor de secretos.
AUTH_CODE_PEPPER_BASE64=
# Comprueba contraseñas contra filtraciones conocidas (k-anonymity). Apágalo solo sin conexión.
PASSWORD_BREACH_CHECK=enabled
# `console` solo imprime los correos. En producción hace falta un proveedor real (brevo).
# Avisos al móvil: console (solo log) o expo (los entrega el servicio de Expo).
PUSH_PROVIDER=console
# Vídeos (solo planes con vídeo): `fake` no llama a nadie; `bunny` los aloja en Bunny Stream.
# Con bunny hacen falta los cuatro valores. Pruébalos con `npm run videos:check`.
VIDEO_PROVIDER=fake
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Clave de autenticación por token de la librería (Security > Token Authentication).
BUNNY_STREAM_TOKEN_KEY=
# Dominio de reproducción de la librería, p. ej. vz-1234abcd-xyz.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
EMAIL_PROVIDER=console
# Permite correos de usar y tirar (yopmail) para probar. Debe estar apagado en producción.
ALLOW_DISPOSABLE_EMAILS=false

# Límite de peticiones por IP. Solo se apaga en tests; en producción es obligatorio.
RATE_LIMITING=enabled

# Clave AES-256 (exactamente 32 bytes en base64) que cifra los secretos del doble factor (TOTP).
# En desarrollo la crea `npm run keys:generate`. En producción: valor distinto en un KMS o gestor de secretos.
MFA_ENCRYPTION_KEY_BASE64=
