// Esquema inicial (API-004): identidad y tenant raíz. Las tablas de negocio se añaden por ticket.
// Prisma no modela RLS ni EXCLUDE: viven en el SQL de cada migración (ver docs/spec/01-arquitectura.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CenterStatus {
  trial
  active
  past_due
  suspended

  @@map("center_status")
}

enum MembershipRole {
  owner
  admin
  staff
  client

  @@map("membership_role")
}

enum IdempotencyStatus {
  in_progress
  completed

  @@map("idempotency_status")
}

enum ConsentKind {
  privacy
  terms
  marketing
  health
  image
  parental

  @@map("consent_kind")
}

enum VerificationPurpose {
  email_verification
  password_reset

  @@map("verification_purpose")
}

/// Por ahora solo `individual` (una persona del equipo atiende a un cliente); los grupos llegan después.
enum ServiceKind {
  individual

  @@map("service_kind")
}

enum ClassSessionStatus {
  scheduled
  cancelled

  @@map("class_session_status")
}

enum BookingStatus {
  confirmed
  cancelled
  attended
  no_show

  @@map("booking_status")
}

enum BookingCancelledBy {
  client
  staff

  @@map("booking_cancelled_by")
}

/// Nivel de un cliente; el texto («Inicio», «Base», «Avanzado») lo pone el vocabulario del sector.
enum ClientLevel {
  beginner
  intermediate
  advanced

  @@map("client_level")
}

/// Lo que avisa una notificación; el texto lo escribe la app con el vocabulario del sector.
enum NotificationKind {
  booking_created
  booking_cancelled
  booking_created_by_team
  booking_cancelled_by_team
  absence_added
  booking_affected_by_absence
  routine_assigned
  staff_video_submitted
  staff_video_reviewed
  privacy_request_received
  privacy_request_resolved
  staff_profile_submitted
  staff_profile_reviewed
  staff_review_received
  booking_rescheduled
  booking_rescheduled_by_team
  routine_updated
  member_joined

  @@map("notification_kind")
}

enum StaffProfileStatus {
  draft
  pending
  published
  changes_requested

  @@map("staff_profile_status")
}

enum StaffReviewStatus {
  pending
  published
  rejected

  @@map("staff_review_status")
}

enum PrivacyRequestKind {
  access
  rectification
  erasure
  objection

  @@map("privacy_request_kind")
}

enum PrivacyRequestStatus {
  open
  completed
  rejected

  @@map("privacy_request_status")
}

enum VideoStatus {
  uploading
  processing
  ready
  failed

  @@map("video_status")
}

enum VideoReviewStatus {
  approved
  pending
  changes_requested

  @@map("video_review_status")
}

/// Por dónde se unió una persona al centro; sirve para contar «este mes se han unido».
enum AbsenceReason {
  vacation
  training
  personal
  other

  @@map("absence_reason")
}

enum JoinSource {
  qr
  link
  code
  search

  @@map("join_source")
}

enum MembershipStatus {
  invited
  active
  blocked
  left

  @@map("membership_status")
}

/// Persona con cuenta. Global (sin center_id): una persona puede tener varios centros.
model User {
  id               String    @id @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  /// Intentos de inicio de sesión fallidos seguidos; al llegar al límite se bloquea un rato.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  phone            String?
  birthDate        DateTime? @map("birth_date") @db.Date
  locale           String    @default("es-ES")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships       Membership[]
  idempotencyKeys   IdempotencyKey[]
  consents          Consent[]
  pushDevices       PushDevice[]
  verificationCodes VerificationCode[]
  refreshTokens     RefreshToken[]
  mfaFactor         MfaFactor?
  mfaRecoveryCodes  MfaRecoveryCode[]

  @@map("users")
}

/// Tenant raíz: un centro (gimnasio, academia...).
model Center {
  id            String       @id @db.Uuid
  slug          String       @unique
  name          String
  sectorId      String       @map("sector_id")
  brandColor    String       @map("brand_color") @db.Char(7)
  timezone      String       @default("Europe/Madrid")
  joinCode      String       @unique @map("join_code") @db.Char(6)
  status        CenterStatus @default(trial)
  /// Aparece en la búsqueda pública. Por defecto un centro es privado: solo se entra con su código.
  isListed      Boolean      @default(false) @map("is_listed")
  city          String?
  latitude      Float?
  longitude     Float?
  /// Tope de clientes activos del plan. Nulo = sin tope.
  maxClients    Int?         @map("max_clients")
  trialEndsAt   DateTime?    @map("trial_ends_at") @db.Timestamptz
  address       String?
  /// Contacto que ve la clientela y datos fiscales para facturar (solo los ve la administración).
  phone         String?
  contactEmail  String?      @map("contact_email")
  legalName     String?      @map("legal_name")
  taxId         String?      @map("tax_id")
  taxAddress    String?      @map("tax_address")
  /// Horario semanal por día: { mon: [{ opensAt: "09:00", closesAt: "14:00" }], ... }
  openingHours  Json?        @map("opening_hours")
  /// Días de cierre: [{ date: "2026-12-25", label: "Navidad" }]
  holidays      Json?
  /// Política de cancelación: { freeCancellationHours, lateCancellationConsumesCredit }
  cancelPolicy  Json?        @map("cancel_policy")
  /// Cu�ndo se subi� el logo vigente; nulo = sin logo. Sirve de versi�n de cach� sin leer los bytes.
  logoUpdatedAt DateTime?    @map("logo_updated_at") @db.Timestamptz
  /// Espacio de vídeo contratado (plan Premium). Nulo = el plan no incluye vídeo. Solo lo cambia Yoclick.
  videoStorageLimitBytes BigInt? @map("video_storage_limit_bytes")
  /// Las opiniones sobre el equipo se revisan antes de publicarse.
  reviewsNeedApproval    Boolean   @default(true) @map("reviews_need_approval")
  /// El equipo (fotos, vídeos y valoraciones) se enseña en la web de reservas.
  showTeamOnWeb          Boolean   @default(true) @map("show_team_on_web")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  videos              Video[]
  staffProfiles       StaffProfile[]
  staffCertifications StaffCertification[]
  staffReviews        StaffReview[]
  privacyRequests     PrivacyRequest[]
  memberships         Membership[]
  invitations         Invitation[]
  logo                CenterLogo?
  services            Service[]
  classSessions       ClassSession[]
  bookings            Booking[]
  rooms               Room[]
  staffAvailabilities StaffAvailability[]
  routines            Routine[]
  routineAssignments  RoutineAssignment[]
  routineCompletions  RoutineCompletion[]
  staffAbsences       StaffAbsence[]
  clientGroups        ClientGroup[]
  notifications       Notification[]
  activityLogs        ActivityLog[]

  @@map("centers")
}

/// Logo del centro (PNG, JPEG o WebP validados por contenido). Los bytes viven aparte de `centers`
/// para no arrastrarlos en cada lectura del centro.
model CenterLogo {
  centerId    String   @id @map("center_id") @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  /// Hash del contenido, usado como ETag.
  sha256      String
  updatedAt   DateTime @map("updated_at") @db.Timestamptz

  center Center @relation(fields: [centerId], references: [id])

  @@map("center_logos")
}

/// Pertenencia de un usuario a un centro con un rol.
model Membership {
  id          String           @id @db.Uuid
  centerId    String           @map("center_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        MembershipRole
  status      MembershipStatus @default(active)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz
  /// Cargo que ve la clientela ("Profesora de yoga"). Solo para el equipo.
  staffTitle  String?          @map("staff_title")
  /// Solo clientes: su nivel y el grupo al que pertenece (uno como máximo).
  level       ClientLevel?
  groupId     String?          @map("group_id") @db.Uuid
  /// Solo clientes: cómo se unió. Nulo si entró antes de que se registrara o por invitación.
  joinSource  JoinSource?      @map("join_source")
  /// Permisos extra del equipo, p. ej. ["health:read"]. Un array de cadenas validado por la API.
  permissions Json             @default("[]")
  /// Solo equipo: su vídeo de presentación (lo ven los clientes cuando el centro lo ha aprobado).
  profileVideoId String?       @unique @map("profile_video_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  center Center       @relation(fields: [centerId], references: [id])
  user   User         @relation(fields: [userId], references: [id])
  group  ClientGroup? @relation("GroupMembers", fields: [groupId], references: [id])
  profileVideo Video? @relation("ProfileVideo", fields: [profileVideoId], references: [id], onDelete: SetNull)

  uploadedVideos      Video[]             @relation("VideoUploader")
  techniqueVideos     Video[]             @relation("TechniqueVideos")
  staffProfile        StaffProfile?       @relation("StaffProfileOwner")
  reviewedStaffProfiles StaffProfile[]    @relation("StaffProfileReviewer")
  verifiedCertifications StaffCertification[] @relation("CertificationVerifier")
  receivedStaffReviews StaffReview[]      @relation("ReviewedStaff")
  writtenStaffReviews StaffReview[]        @relation("ReviewAuthor")
  moderatedStaffReviews StaffReview[]     @relation("ReviewModerator")
  privacyRequests     PrivacyRequest[]    @relation("PrivacyRequester")
  resolvedPrivacyRequests PrivacyRequest[] @relation("PrivacyResolver")
  instructedGroups    ClientGroup[]       @relation("GroupInstructor")
  notifications       Notification[]      @relation("NotificationRecipient")
  serviceAssignments  ServiceStaff[]
  taughtClassSessions ClassSession[]      @relation("StaffClassSessions")
  bookings            Booking[]           @relation("ClientBookings")
  availability        StaffAvailability?
  authoredRoutines    Routine[]           @relation("RoutineAuthor")
  receivedRoutines    RoutineAssignment[] @relation("RoutineClient")
  routineCompletions  RoutineCompletion[] @relation("RoutineDoneBy")
  assignedRoutines    RoutineAssignment[] @relation("RoutineAssigner")
  absences            StaffAbsence[]
  startedBookings     Booking[]           @relation("BookingStartedBy")
  endedBookings       Booking[]           @relation("BookingEndedBy")
  checkedInBookings   Booking[]           @relation("BookingCheckedInBy")

  @@unique([centerId, userId])
  @@index([centerId, role])
  @@index([userId])
  @@map("memberships")
}

/// Respuesta guardada de una operación con Idempotency-Key: reintentar no repite el efecto.
/// Acotada por persona (no por centro): la clave la genera la app por cada intención del usuario.
model IdempotencyKey {
  id                 String            @id @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  key                String            @db.Uuid
  operation          String
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus @default(in_progress)
  responseStatus     Int?              @map("response_status")
  responseBody       Json?             @map("response_body")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Consentimiento (RGPD). Inmutable: una fila por cambio, nunca se actualiza ni se borra.
model Consent {
  id        String      @id @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      ConsentKind
  /// Versión del texto legal que la persona aceptó.
  version   String
  isGranted Boolean     @map("is_granted")
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz
  /// Hash del IP, no el IP: sirve de evidencia sin guardar un dato personal directo.
  ipHash    String?     @map("ip_hash")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, kind, grantedAt])
  @@map("consents")
}

/// Código de 6 dígitos de un solo uso (verificar email, recuperar contraseña). Solo se guarda su HMAC.
model VerificationCode {
  id           String              @id @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  purpose      VerificationPurpose
  codeHash     String              @map("code_hash")
  attemptCount Int                 @default(0) @map("attempt_count")
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz
  consumedAt   DateTime?           @map("consumed_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose, createdAt])
  @@map("verification_codes")
}

/// Sesión larga de un dispositivo. El token es opaco y aleatorio (256 bits); aquí solo vive su SHA-256.
/// Rota en cada uso: el anterior queda revocado y apunta al nuevo. Usar uno ya revocado delata un robo
/// y revoca toda la familia (todos los tokens descendientes del mismo inicio de sesión).
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  /// La sesión se abrió con segundo factor: se conserva en toda la familia al rotar.
  mfaVerified  Boolean   @default(false) @map("mfa_verified")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Segundo factor TOTP de una persona. El secreto va CIFRADO (AES-256-GCM), nunca en claro (SEC-70).
model MfaFactor {
  id              String    @id @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_enc")
  /// Hasta que se confirma con un primer código válido, el factor no cuenta ni se exige.
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz
  /// Último intervalo de 30 s aceptado: un código ya usado no sirve otra vez (anti-reutilización).
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("mfa_factors")
}

/// Códigos de recuperación de un solo uso, por si se pierde el dispositivo. Solo se guarda su HMAC.
model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Invitación a unirse a un centro con un rol. El código viaja por correo; aquí solo su hash.
model Invitation {
  id              String         @id @db.Uuid
  centerId        String         @map("center_id") @db.Uuid
  /// Correo al que se envió; nulo si se invitó por teléfono (entonces vale cualquier cuenta).
  email           String?
  /// Teléfono al que se compartió el código, normalizado (`+34600111222`).
  phone           String?
  role            MembershipRole
  tokenHash       String         @unique @map("token_hash")
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz
  /// Quién la aceptó: si la misma cuenta repite la petición, recibe lo mismo en vez de un error.
  acceptedByUserId String?       @map("accepted_by_user_id") @db.Uuid
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  center Center @relation(fields: [centerId], references: [id])

  @@index([centerId, email])
  @@index([centerId, phone])
  @@map("invitations")
}

/// Lo que el centro ofrece y se puede reservar. Se archiva, no se borra: las reservas existentes se conservan.
model Service {
  id                  String      @id @db.Uuid
  centerId            String      @map("center_id") @db.Uuid
  name                String
  description         String?
  kind                ServiceKind @default(individual)
  durationMinutes     Int         @map("duration_minutes")
  capacity            Int         @default(1)
  /// En céntimos; nulo = "a consultar".
  priceCents          Int?        @map("price_cents")
  color               String?     @db.Char(7)
  /// Cuántos días hacia delante se puede reservar.
  bookingWindowDays   Int         @default(30) @map("booking_window_days")
  /// Antelación mínima para reservar.
  minNoticeMinutes    Int         @default(120) @map("min_notice_minutes")
  /// Nulo = se usa la política de cancelación del centro.
  cancelNoticeMinutes Int?        @map("cancel_notice_minutes")
  isVisible           Boolean     @default(true) @map("is_visible")
  sortOrder           Int         @default(0) @map("sort_order")
  /// Sala o recurso donde se da; nulo = sin sala fija.
  roomId              String?     @map("room_id") @db.Uuid
  archivedAt          DateTime?   @map("archived_at") @db.Timestamptz
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  center        Center         @relation(fields: [centerId], references: [id])
  room          Room?          @relation(fields: [roomId], references: [id])
  staff         ServiceStaff[]
  classSessions ClassSession[]

  @@index([centerId, sortOrder])
  @@map("services")
}

/// Aviso para alguien del centro (nueva reserva, cita cancelada…). Cada persona ve solo los suyos.
model Notification {
  id                    String           @id @db.Uuid
  centerId              String           @map("center_id") @db.Uuid
  recipientMembershipId String           @map("recipient_membership_id") @db.Uuid
  kind                  NotificationKind
  /// Los datos del aviso (cliente, servicio, hora…): el texto se compone en la app.
  data                  Json
  bookingId             String?          @map("booking_id") @db.Uuid
  readAt                DateTime?        @map("read_at") @db.Timestamptz
  /// Cuándo se envió el aviso al móvil; nulo mientras no se haya enviado (o no haya móvil registrado).
  pushedAt              DateTime?        @map("pushed_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz

  center    Center     @relation(fields: [centerId], references: [id])
  recipient Membership @relation("NotificationRecipient", fields: [recipientMembershipId], references: [id])

  @@index([centerId, recipientMembershipId, createdAt])
  @@index([centerId, pushedAt])
  @@map("notifications")
}

/// Un móvil de una persona al que se le pueden enviar avisos push. El token lo da Expo.
model PushDevice {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// Registro de actividad del centro: quién cambió qué. Solo se añade; no se edita ni se borra.
model ActivityLog {
  id                String   @id @db.Uuid
  centerId          String   @map("center_id") @db.Uuid
  /// Quién lo hizo; nulo si fue el sistema.
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  /// Qué pasó (`service_updated`, `client_updated`…): la frase se compone en la app.
  kind              String
  /// Sobre qué o quién (el nombre del servicio, de la persona…).
  subject           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  center Center @relation(fields: [centerId], references: [id])

  @@index([centerId, createdAt])
  @@map("activity_logs")
}

/// Grupo de clientes del centro (p. ej. «Grupo mañanas»), con su nivel y quien lo da. Se archiva, no se borra.
model ClientGroup {
  id                     String       @id @db.Uuid
  centerId               String       @map("center_id") @db.Uuid
  name                   String
  level                  ClientLevel?
  instructorMembershipId String?      @map("instructor_membership_id") @db.Uuid
  archivedAt             DateTime?    @map("archived_at") @db.Timestamptz
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz

  center             Center              @relation(fields: [centerId], references: [id])
  instructor         Membership?         @relation("GroupInstructor", fields: [instructorMembershipId], references: [id])
  members            Membership[]        @relation("GroupMembers")
  routineAssignments RoutineAssignment[]

  @@index([centerId])
  @@map("client_groups")
}

/// Rutina, práctica, secuencia o tarea: lo que el equipo prepara para sus clientes. Se archiva, no se borra.
model Routine {
  id                    String    @id @db.Uuid
  centerId              String    @map("center_id") @db.Uuid
  name                  String
  /// Indicaciones generales que ve quien la recibe («descansa 90 s entre series»).
  note                  String?
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  center      Center              @relation(fields: [centerId], references: [id])
  createdBy   Membership          @relation("RoutineAuthor", fields: [createdByMembershipId], references: [id])
  items       RoutineItem[]
  assignments RoutineAssignment[]
  completions RoutineCompletion[]

  @@index([centerId])
  @@map("routines")
}

/// Un ejercicio dentro de una rutina. El nombre se copia de la biblioteca (o se escribe): no hay clave a la biblioteca.
model RoutineItem {
  id           String  @id @db.Uuid
  routineId    String  @map("routine_id") @db.Uuid
  position     Int
  name         String
  category     String?
  /// Texto libre: «4 × 10 · 16 kg», «5 min».
  prescription String?
  /// Vídeo que muestra cómo se hace el ejercicio (solo centros con vídeo).
  videoId      String? @map("video_id") @db.Uuid

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@unique([routineId, position])
  @@map("routine_items")
}

/// A quién se asigna una rutina: a una persona o a un grupo (exactamente uno de los dos).
model RoutineAssignment {
  id                     String   @id @db.Uuid
  centerId               String   @map("center_id") @db.Uuid
  routineId              String   @map("routine_id") @db.Uuid
  clientMembershipId     String?  @map("client_membership_id") @db.Uuid
  groupId                String?  @map("group_id") @db.Uuid
  assignedByMembershipId String   @map("assigned_by_membership_id") @db.Uuid
  assignedAt             DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  center     Center       @relation(fields: [centerId], references: [id])
  routine    Routine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  client     Membership?  @relation("RoutineClient", fields: [clientMembershipId], references: [id], onDelete: Restrict)
  group      ClientGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedBy Membership   @relation("RoutineAssigner", fields: [assignedByMembershipId], references: [id])

  @@index([centerId, routineId])
  @@index([clientMembershipId])
  @@index([groupId])
  @@map("routine_assignments")
}

/// «Hoy hice esta rutina»: una vez por rutina, persona y día local del centro.
model RoutineCompletion {
  id                 String   @id @db.Uuid
  centerId           String   @map("center_id") @db.Uuid
  routineId          String   @map("routine_id") @db.Uuid
  clientMembershipId String   @map("client_membership_id") @db.Uuid
  completedAt        DateTime @default(now()) @map("completed_at") @db.Timestamptz
  /// Día local del centro (`YYYY-MM-DD`): lo que impide registrar dos veces el mismo día.
  completedOn        String   @map("completed_on")
  /// Cuántos ejercicios marcó como hechos, de cuántos tenía la rutina en ese momento.
  completedItemCount Int      @map("completed_item_count")
  totalItemCount     Int      @map("total_item_count")

  center  Center     @relation(fields: [centerId], references: [id])
  routine Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  client  Membership @relation("RoutineDoneBy", fields: [clientMembershipId], references: [id])

  @@unique([routineId, clientMembershipId, completedOn])
  @@index([centerId, routineId])
  @@index([clientMembershipId])
  @@map("routine_completions")
}

/// Sala o recurso del centro (Sala 1, Tatami, Zona de peso libre). Se archiva, no se borra.
model Room {
  id         String    @id @db.Uuid
  centerId   String    @map("center_id") @db.Uuid
  name       String
  /// Aforo máximo de la sala.
  capacity   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  center   Center    @relation(fields: [centerId], references: [id])
  services Service[]

  @@index([centerId])
  @@map("rooms")
}

/// Horario semanal propio de una persona del equipo. Sin fila sigue el horario del centro.
model StaffAvailability {
  membershipId String   @id @map("membership_id") @db.Uuid
  centerId     String   @map("center_id") @db.Uuid
  /// Mismo formato que el horario del centro: { mon: [{ opensAt, closesAt }], … }; un día sin tramos no trabaja.
  weeklyHours  Json     @map("weekly_hours")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  membership Membership @relation(fields: [membershipId], references: [id])
  center     Center     @relation(fields: [centerId], references: [id])

  @@index([centerId])
  @@map("staff_availability")
}

/// Días en los que una persona del equipo no atiende (vacaciones, formación…); ambos extremos incluidos.
model StaffAbsence {
  id           String        @id @db.Uuid
  centerId     String        @map("center_id") @db.Uuid
  membershipId String        @map("membership_id") @db.Uuid
  startsOn     DateTime      @map("starts_on") @db.Date
  endsOn       DateTime      @map("ends_on") @db.Date
  reason       AbsenceReason
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  membership Membership @relation(fields: [membershipId], references: [id])
  center     Center     @relation(fields: [centerId], references: [id])

  @@index([centerId, membershipId])
  @@map("staff_absences")
}

/// Quién del equipo puede atender un servicio.
model ServiceStaff {
  serviceId    String @map("service_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid

  service    Service    @relation(fields: [serviceId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@id([serviceId, membershipId])
  @@index([membershipId])
  @@map("service_staff")
}

/// Una ocurrencia de un servicio. En esta fase, una fila por reserva individual (se crea al reservar).
/// Una restricción EXCLUDE (en el SQL de la migración) impide que una misma persona del equipo
/// tenga dos sesiones programadas solapadas.
model ClassSession {
  id                String             @id @db.Uuid
  centerId          String             @map("center_id") @db.Uuid
  serviceId         String             @map("service_id") @db.Uuid
  staffMembershipId String             @map("staff_membership_id") @db.Uuid
  startsAt          DateTime           @map("starts_at") @db.Timestamptz
  endsAt            DateTime           @map("ends_at") @db.Timestamptz
  capacity          Int                @default(1)
  status            ClassSessionStatus @default(scheduled)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz

  center          Center     @relation(fields: [centerId], references: [id])
  service         Service    @relation(fields: [serviceId], references: [id])
  staffMembership Membership @relation("StaffClassSessions", fields: [staffMembershipId], references: [id])
  bookings        Booking[]

  @@index([centerId, startsAt])
  @@index([centerId, staffMembershipId, startsAt])
  @@map("class_sessions")
}

model Booking {
  id                      String              @id @db.Uuid
  centerId                String              @map("center_id") @db.Uuid
  classSessionId          String              @map("class_session_id") @db.Uuid
  clientMembershipId      String              @map("client_membership_id") @db.Uuid
  status                  BookingStatus       @default(confirmed)
  cancelledAt             DateTime?           @map("cancelled_at") @db.Timestamptz
  cancelledBy             BookingCancelledBy? @map("cancelled_by")
  /// Si se canceló con la antelación que marca la política; nulo mientras no se cancele.
  cancelWithinPolicy      Boolean?            @map("cancel_within_policy")
  idempotencyKey          String?             @map("idempotency_key") @db.Uuid
  /// Registro de la clase: lo escribe el servidor al iniciarla y terminarla, nunca la app.
  startedAt               DateTime?           @map("started_at") @db.Timestamptz
  endedAt                 DateTime?           @map("ended_at") @db.Timestamptz
  startedByMembershipId   String?             @map("started_by_membership_id") @db.Uuid
  endedByMembershipId     String?             @map("ended_by_membership_id") @db.Uuid
  sessionNotes            String?             @map("session_notes")
  /// Llegada de la persona: la registra el servidor al escanear su QR de asistencia.
  checkedInAt             DateTime?           @map("checked_in_at") @db.Timestamptz
  checkedInByMembershipId String?             @map("checked_in_by_membership_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  center           Center       @relation(fields: [centerId], references: [id])
  classSession     ClassSession @relation(fields: [classSessionId], references: [id])
  clientMembership Membership   @relation("ClientBookings", fields: [clientMembershipId], references: [id])
  startedBy        Membership?  @relation("BookingStartedBy", fields: [startedByMembershipId], references: [id])
  endedBy          Membership?  @relation("BookingEndedBy", fields: [endedByMembershipId], references: [id])
  checkedInBy      Membership?  @relation("BookingCheckedInBy", fields: [checkedInByMembershipId], references: [id])
  staffReview      StaffReview?

  @@unique([clientMembershipId, idempotencyKey])
  @@index([centerId, classSessionId])
  @@index([centerId, clientMembershipId, status])
  @@index([centerId, startedAt])
  @@map("bookings")
}

/// Un vídeo alojado en el servicio de vídeo (Bunny Stream). La base de datos solo guarda sus datos;
/// el fichero y su reproducción adaptativa viven fuera.
model Video {
  id                    String            @id @db.Uuid
  centerId              String            @map("center_id") @db.Uuid
  /// Identificador del vídeo en el servicio de vídeo.
  providerVideoId       String            @unique @map("provider_video_id")
  title                 String
  status                VideoStatus       @default(uploading)
  /// Los de rutinas nacen aprobados; el de presentación del equipo espera la revisión del centro.
  reviewStatus          VideoReviewStatus @default(approved) @map("review_status")
  reviewNote            String?           @map("review_note")
  /// Lo que el móvil dice que va a subir (para reservar espacio) y, al procesarse, lo que ocupa de verdad.
  sizeBytes             BigInt            @default(0) @map("size_bytes")
  durationSeconds       Int?              @map("duration_seconds")
  uploadedByMembershipId String           @map("uploaded_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz

  center       Center        @relation(fields: [centerId], references: [id])
  uploadedBy   Membership    @relation("VideoUploader", fields: [uploadedByMembershipId], references: [id])
  /// Si es uno de los vídeos de técnica de alguien del equipo (hasta tres).
  techniqueOfMembershipId String? @map("technique_of_membership_id") @db.Uuid
  techniqueOf  Membership?   @relation("TechniqueVideos", fields: [techniqueOfMembershipId], references: [id], onDelete: SetNull)
  routineItems RoutineItem[]
  profileOf    Membership?   @relation("ProfileVideo")

  @@index([centerId])
  @@map("videos")
}

/// Solicitud de un derecho RGPD de un cliente al centro (el centro es el responsable del tratamiento).
/// Se responde en un mes como mucho; no se borra, queda como constancia.
model PrivacyRequest {
  id                     String               @id @db.Uuid
  centerId               String               @map("center_id") @db.Uuid
  clientMembershipId     String               @map("client_membership_id") @db.Uuid
  kind                   PrivacyRequestKind
  status                 PrivacyRequestStatus @default(open)
  /// Lo que la persona cuenta de su solicitud (opcional).
  message                String?
  /// Fecha límite de respuesta: un mes desde que se recibe.
  dueAt                  DateTime             @map("due_at") @db.Timestamptz
  resolvedAt             DateTime?            @map("resolved_at") @db.Timestamptz
  resolvedByMembershipId String?              @map("resolved_by_membership_id") @db.Uuid
  resolutionNote         String?              @map("resolution_note")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz

  center           Center      @relation(fields: [centerId], references: [id])
  clientMembership Membership  @relation("PrivacyRequester", fields: [clientMembershipId], references: [id])
  resolvedBy       Membership? @relation("PrivacyResolver", fields: [resolvedByMembershipId], references: [id], onDelete: Restrict)

  @@index([centerId, status, dueAt])
  @@index([clientMembershipId])
  @@map("privacy_requests")
}

/// Perfil profesional de quien da las sesiones: lo ven los clientes cuando el centro lo ha aprobado.
model StaffProfile {
  membershipId           String             @id @map("membership_id") @db.Uuid
  centerId               String             @map("center_id") @db.Uuid
  headline               String?
  bio                    String?
  specialties            String[]
  languages              String[]
  status                 StaffProfileStatus @default(draft)
  /// Lo que el centro pide cambiar (con el estado `changes_requested`).
  reviewNote             String?            @map("review_note")
  /// Cuándo autorizó la persona publicar su imagen y sus vídeos; sin ello no se envía a revisión.
  publishConsentAt       DateTime?          @map("publish_consent_at") @db.Timestamptz
  submittedAt            DateTime?          @map("submitted_at") @db.Timestamptz
  reviewedAt             DateTime?          @map("reviewed_at") @db.Timestamptz
  reviewedByMembershipId String?            @map("reviewed_by_membership_id") @db.Uuid
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  center         Center               @relation(fields: [centerId], references: [id])
  membership     Membership           @relation("StaffProfileOwner", fields: [membershipId], references: [id])
  reviewedBy     Membership?          @relation("StaffProfileReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: Restrict)
  certifications StaffCertification[]

  @@index([centerId, status])
  @@map("staff_profiles")
}

/// Una titulación del perfil. El centro la marca como verificada tras comprobarla.
model StaffCertification {
  id                     String    @id @db.Uuid
  centerId               String    @map("center_id") @db.Uuid
  membershipId           String    @map("membership_id") @db.Uuid
  name                   String
  /// Dónde y cuándo («Universidad, 2016»).
  detail                 String?
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz
  verifiedByMembershipId String?   @map("verified_by_membership_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  center     Center       @relation(fields: [centerId], references: [id])
  profile    StaffProfile @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade)
  verifiedBy Membership?  @relation("CertificationVerifier", fields: [verifiedByMembershipId], references: [id], onDelete: Restrict)

  @@index([membershipId])
  @@map("staff_certifications")
}

/// Opinión de un cliente sobre quien le dio una sesión. Solo tras una sesión real, una por reserva.
model StaffReview {
  id                    String            @id @db.Uuid
  centerId              String            @map("center_id") @db.Uuid
  staffMembershipId     String            @map("staff_membership_id") @db.Uuid
  clientMembershipId    String            @map("client_membership_id") @db.Uuid
  bookingId             String            @unique @map("booking_id") @db.Uuid
  rating                Int
  comment               String?
  status                StaffReviewStatus @default(pending)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  moderatedAt           DateTime?         @map("moderated_at") @db.Timestamptz
  moderatedByMembershipId String?         @map("moderated_by_membership_id") @db.Uuid

  center    Center     @relation(fields: [centerId], references: [id])
  booking   Booking    @relation(fields: [bookingId], references: [id])
  staff     Membership @relation("ReviewedStaff", fields: [staffMembershipId], references: [id])
  client    Membership @relation("ReviewAuthor", fields: [clientMembershipId], references: [id])
  moderator Membership? @relation("ReviewModerator", fields: [moderatedByMembershipId], references: [id], onDelete: Restrict)

  @@index([centerId, status])
  @@index([staffMembershipId, status])
  @@map("staff_reviews")
}
