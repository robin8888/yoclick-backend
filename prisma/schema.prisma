// Esquema inicial (API-004): identidad y tenant raíz. Las tablas de negocio se añaden por ticket.
// Prisma no modela RLS ni EXCLUDE: viven en el SQL de cada migración (ver docs/spec/01-arquitectura.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CenterStatus {
  trial
  active
  past_due
  suspended

  @@map("center_status")
}

enum MembershipRole {
  owner
  admin
  staff
  client

  @@map("membership_role")
}

enum IdempotencyStatus {
  in_progress
  completed

  @@map("idempotency_status")
}

enum ConsentKind {
  privacy
  terms
  marketing
  health
  image
  parental

  @@map("consent_kind")
}

enum VerificationPurpose {
  email_verification
  password_reset

  @@map("verification_purpose")
}

enum MembershipStatus {
  invited
  active
  blocked
  left

  @@map("membership_status")
}

/// Persona con cuenta. Global (sin center_id): una persona puede tener varios centros.
model User {
  id               String    @id @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  /// Intentos de inicio de sesión fallidos seguidos; al llegar al límite se bloquea un rato.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships       Membership[]
  idempotencyKeys   IdempotencyKey[]
  consents          Consent[]
  verificationCodes VerificationCode[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

/// Tenant raíz: un centro (gimnasio, academia...).
model Center {
  id         String       @id @db.Uuid
  slug       String       @unique
  name       String
  sectorId   String       @map("sector_id")
  brandColor String       @map("brand_color") @db.Char(7)
  timezone   String       @default("Europe/Madrid")
  joinCode   String       @unique @map("join_code") @db.Char(6)
  status     CenterStatus @default(trial)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]

  @@map("centers")
}

/// Pertenencia de un usuario a un centro con un rol.
model Membership {
  id        String           @id @db.Uuid
  centerId  String           @map("center_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(active)
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  center Center @relation(fields: [centerId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([centerId, userId])
  @@index([centerId, role])
  @@index([userId])
  @@map("memberships")
}

/// Respuesta guardada de una operación con Idempotency-Key: reintentar no repite el efecto.
/// Acotada por persona (no por centro): la clave la genera la app por cada intención del usuario.
model IdempotencyKey {
  id                 String            @id @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  key                String            @db.Uuid
  operation          String
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus @default(in_progress)
  responseStatus     Int?              @map("response_status")
  responseBody       Json?             @map("response_body")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Consentimiento (RGPD). Inmutable: una fila por cambio, nunca se actualiza ni se borra.
model Consent {
  id        String      @id @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      ConsentKind
  /// Versión del texto legal que la persona aceptó.
  version   String
  isGranted Boolean     @map("is_granted")
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz
  /// Hash del IP, no el IP: sirve de evidencia sin guardar un dato personal directo.
  ipHash    String?     @map("ip_hash")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, kind, grantedAt])
  @@map("consents")
}

/// Código de 6 dígitos de un solo uso (verificar email, recuperar contraseña). Solo se guarda su HMAC.
model VerificationCode {
  id           String              @id @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  purpose      VerificationPurpose
  codeHash     String              @map("code_hash")
  attemptCount Int                 @default(0) @map("attempt_count")
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz
  consumedAt   DateTime?           @map("consumed_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose, createdAt])
  @@map("verification_codes")
}

/// Sesión larga de un dispositivo. El token es opaco y aleatorio (256 bits); aquí solo vive su SHA-256.
/// Rota en cada uso: el anterior queda revocado y apunta al nuevo. Usar uno ya revocado delata un robo
/// y revoca toda la familia (todos los tokens descendientes del mismo inicio de sesión).
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
